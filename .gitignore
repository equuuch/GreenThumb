# виртуальное окружение
venv/
.venv/
env/
bin/
lib/
include/

# кэш питона и линтеров
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# секреты и ключи api
.env
.env.*
!.env.example

# база данных (храним только код сида, а не сам файл базы)
*.db
*.sqlite3
*.db-journal

# медиа файлы пользователей и отчеты
# сохраняем структуру папок через .gitkeep, но игнорируем контент
assets/uploads/*
!assets/uploads/.gitkeep
assets/reports/*
!assets/reports/.gitkeep

# локальные тестовые артефакты в корне
# игнорируем фотографии, которые мы использовали для разовых тестов ии
test_*.jpg
test_*.jpeg
test_*.png

# специфичные файлы flet и сборки pwa/android
dist/
build/
__flet_build__/
*.apk
*.exe

# системные файлы и логи
*.log
.vscode/
.idea/
.DS_Store
Thumbs.db
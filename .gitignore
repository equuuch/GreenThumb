# виртуальное окружение
venv/
.venv/
env/
bin/
lib/
include/

# кэш питона
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# секреты
.env
.env.*
!.env.example

# база данных (храним только код сида, а не сам файл базы)
*.db
*.sqlite3
*.db-journal

# медиа файлы пользователей и отчеты
assets/uploads/*
!assets/uploads/.gitkeep
assets/reports/*
!assets/reports/.gitkeep

# специфичные файлы flet и сборки
dist/
build/
__flet_build__/
*.apk
*.exe

# системные файлы и логи
*.log
.vscode/
.idea/
.DS_Store
Thumbs.db
# сбер секретики
# авторизационный ключ в формате base64 из личного кабинета
GIGACHAT_CREDENTIALS="your_base64_credentials_here"
# идентификатор клиента из личного кабинета
GIGACHAT_CLIENT_ID="your_client_id_here"
# область доступа (GIGACHAT_API_PERS для физлиц)
GIGACHAT_SCOPE="GIGACHAT_API_PERS"
# техническое название модели для текстовых консультаций
GIGACHAT_MODEL_LITE="GigaChat"
# техническое название модели для анализа изображений
GIGACHAT_MODEL_MAX="GigaChat-Max"

# бд секретики
# строка подключения к базе данных sqlite
DATABASE_URL="sqlite:///greenthumb.db"
# флаг детализации логов базы данных (true или false)
DB_ECHO=True
# секретный ключ для подписи сессий и хеширования
SECRET_KEY="generate_your_unique_secret_key_here"